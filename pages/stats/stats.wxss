.page {
  min-height: 100vh;
  padding: 40rpx 28rpx 64rpx;
}

.hero {
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(37, 51, 76, 0.08);
}

.title {
  color: #0f172a;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  margin-top: 10rpx;
  color: #667085;
  font-size: 27rpx;
}

.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.overview-item {
  min-height: 124rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(37, 51, 76, 0.08);
}

.overview-value {
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-all;
}

.overview-label {
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
}

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  color: #344054;
  background: #ffffff;
  font-size: 27rpx;
  box-shadow: 0 8rpx 28rpx rgba(37, 51, 76, 0.08);
}

.section-title {
  margin: 34rpx 0 16rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.stat-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.stat-item {
  padding: 22rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  background: #ffffff;
}

.stat-name {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.stat-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 25rpx;
  line-height: 1.5;
}

.stat-rate {
  margin-top: 8rpx;
  color: #2563eb;
  font-size: 27rpx;
  font-weight: 600;
}
