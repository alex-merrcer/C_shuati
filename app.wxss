page {
  min-height: 100%;
  color: #1f2937;
  background: #f4f7fb;
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
button {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  line-height: 1;
}

button::after {
  border: 0;
}
